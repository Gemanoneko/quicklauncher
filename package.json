{
  "name": "quicklauncher",
  "productName": "QuickLauncher",
  "version": "1.104.2",
  "description": "Cyberpunk-themed desktop quick launcher",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "clean:dist": "node scripts/clean-dist.js",
    "check:contrast": "node scripts/check-theme-contrast.js",
    "check:hover": "node scripts/theme-gallery/run.mjs --hover-check",
    "check": "npm run check:contrast && npm run check:hover",
    "gallery:themes": "node scripts/theme-gallery/run.mjs",
    "gallery:regions": "node scripts/theme-gallery/regions.mjs",
    "test:regions": "node --test test/",
    "selftest:regions": "node scripts/regions-selftest.mjs",
    "tryit:regions": "node scripts/tryit-regions.mjs",
    "prebuild": "npm run check",
    "build": "npm run clean:dist && electron-builder --win --publish always",
    "release": "node scripts/release.mjs",
    "postbuild": "node scripts/cleanup-releases.js",
    "pack": "npm run clean:dist && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.antigravity.quicklauncher",
    "productName": "QuickLauncher",
    "copyright": "Copyright © 2025 Antigravity Projects",
    "icon": "icon.png",
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "files": [
      "src/**/*",
      "icon.png",
      "package.json",
      "!**/node_modules/js-yaml/bin{,/**/*}",
      "!**/node_modules/js-yaml/dist/*.map",
      "!**/node_modules/js-yaml/dist/js-yaml{.js,.min.js}",
      "!**/node_modules/js-yaml/lib/index_vite_proxy.tmp.mjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "scripts/nsis/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Gemanoneko",
      "repo": "quicklauncher",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  }
}
